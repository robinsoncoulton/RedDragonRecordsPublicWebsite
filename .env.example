REACT_APP_JOIN_FORM_ENDPOINT=https://formsubmit.co/ajax/contact@reddragonrecords.tw

# GA4 Measurement ID (G-XXXXXXXX). Create a web stream for reddragonrecords.tw
# at https://analytics.google.com then enable Google signals
# (Admin → Data collection) for age, gender, and interest reports.
# Store the same value as GitHub Actions secret REACT_APP_GA_MEASUREMENT_ID.
REACT_APP_GA_MEASUREMENT_ID=

# Client portal API. Defaults to http://localhost:8787 in `npm start`
# and https://api.reddragonrecords.tw in builds.
REACT_APP_API_URL=
